{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/join", "destination": "https://cleaning-heroes-crm.vercel.app/join" },
    { "source": "/referral", "destination": "https://cleaning-heroes-crm.vercel.app/referral" },
    { "source": "/api/growth/:path*", "destination": "https://cleaning-heroes-crm.vercel.app/api/growth/:path*" },
    { "source": "/_next/:path*", "destination": "https://cleaning-heroes-crm.vercel.app/_next/:path*" },
    { "source": "/logo.png", "destination": "https://cleaning-heroes-crm.vercel.app/logo.png" },
    { "source": "/icon.png", "destination": "https://cleaning-heroes-crm.vercel.app/icon.png" },
    { "source": "/manifest.webmanifest", "destination": "https://cleaning-heroes-crm.vercel.app/manifest.webmanifest" }
  ],
  "git": {
    "deploymentEnabled": {
      "website": false
    }
  }
}
